generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgres"
  url      = env("DATABASE_URL")
}

model Tenant {
  id                    String        @id @default(uuid()) @map("id") @db.Uuid
  name                  String        @map("name") @db.VarChar(255)
  streetAddress         String?       @map("street_address") @db.VarChar(255)
  postalCode            String?       @map("postal_code") @db.VarChar(255)
  city                  String?       @map("city") @db.VarChar(255)
  phone                 String?       @map("phone") @db.VarChar(255)
  email                 String?       @map("email") @db.VarChar(255)
  website               String?       @map("website") @db.VarChar(255)
  businessId            String?       @map("business_id") @db.VarChar(255)
  invoiceBankName       String?       @map("invoice_bank_name") @db.VarChar(255)
  invoiceBankAccount    String?       @map("invoice_bank_account") @db.VarChar(255)
  invoiceSumRow         String?       @map("invoice_sum_row") @db.VarChar(255)
  signupCompleted       Boolean       @default(false) @map("signup_completed")
  createdAt             DateTime      @default(now()) @map("created_at")
  updatedAt             DateTime      @default(now()) @updatedAt @map("updated_at")
  subscriptionType      String        @default("FREE") @map("subscription_type")
  subscriptionEndDate   DateTime?     @map("subscription_end_date")
  subscriptionStartDate DateTime?     @map("subscription_start_date")
  trialEndDate          DateTime?     @map("trial_end_date")
  customers             Customer[]
  orders                Order[]
  orderRows             OrderRow[]
  users                 User[]
  products              Product[]
  PackageType           PackageType[]
  PackageSize           PackageSize[]
  invoices              Invoice[]

  @@map("tenant")
}

model TenantHistory {
  revision  Int    @id @default(autoincrement()) @map("revision")
  operation String @map("operation")

  id                    String    @map("id") @db.Uuid
  name                  String    @map("name") @db.VarChar(255)
  streetAddress         String?   @map("street_address") @db.VarChar(255)
  postalCode            String?   @map("postal_code") @db.VarChar(255)
  city                  String?   @map("city") @db.VarChar(255)
  phone                 String?   @map("phone") @db.VarChar(255)
  email                 String?   @map("email") @db.VarChar(255)
  website               String?   @map("website") @db.VarChar(255)
  businessId            String?   @map("business_id") @db.VarChar(255)
  invoiceBankName       String?   @map("invoice_bank_name") @db.VarChar(255)
  invoiceBankAccount    String?   @map("invoice_bank_account") @db.VarChar(255)
  invoiceSumRow         String?   @map("invoice_sum_row") @db.VarChar(255)
  signupCompleted       Boolean   @map("signup_completed")
  createdAt             DateTime  @map("created_at")
  updatedAt             DateTime  @map("updated_at")
  subscriptionType      String    @map("subscription_type")
  subscriptionEndDate   DateTime? @map("subscription_end_date")
  subscriptionStartDate DateTime? @map("subscription_start_date")
  trialEndDate          DateTime? @map("trial_end_date")

  @@map("tenant_history")
}

enum Role {
  USER
  OWNER
}

model User {
  id               String    @id @default(uuid()) @map("id") @db.Uuid
  googleExternalId String?   @unique @map("google_external_id") @db.VarChar(128)
  email            String    @unique @map("email")
  tenantId         String    @map("tenant_id") @db.Uuid
  tenant           Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role             Role      @default(USER) @map("role")
  marketingConsent Boolean   @default(false) @map("marketing_consent")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at")
  lastLoginAt      DateTime? @map("last_login_at")

  @@map("user")
}

model UserHistory {
  revision  Int    @id @default(autoincrement()) @map("revision")
  operation String @map("operation")

  id               String    @map("id") @db.Uuid
  googleExternalId String?   @map("google_external_id") @db.VarChar(128)
  email            String    @map("email")
  tenantId         String    @map("tenant_id") @db.Uuid
  role             Role      @default(USER) @map("role")
  marketingConsent Boolean   @map("marketing_consent")
  createdAt        DateTime  @map("created_at")
  updatedAt        DateTime  @map("updated_at")
  lastLoginAt      DateTime? @map("last_login_at")

  @@map("user_history")
}

model EmailLoginPinCode {
  id        String   @id @default(cuid()) @map("id")
  email     String   @map("email")
  pinCode   String   @map("pin_code")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("email_login_pin_code")
}

model EmailLoginPinCodeHistory {
  revision  Int    @id @default(autoincrement()) @map("revision")
  operation String @map("operation")

  id        String   @map("id")
  email     String   @map("email")
  pinCode   String   @map("pin_code")
  createdAt DateTime @map("created_at")
  updatedAt DateTime @map("updated_at")

  @@map("email_login_pin_code_history")
}

model Customer {
  id               String    @id @default(uuid()) @map("id") @db.Uuid
  name             String    @map("name") @db.VarChar(50)
  companyLegalName String?   @map("company_legal_name") @db.VarChar(255)
  discount         Decimal   @map("discount") @db.Decimal(10, 2)
  invoiceReference String?   @map("invoice_reference") @db.VarChar(255)
  email            String?   @map("email") @db.VarChar(255)
  phone            String?   @map("phone") @db.VarChar(255)
  streetAddress    String?   @map("street_address") @db.VarChar(255)
  postalCode       String?   @map("postal_code") @db.VarChar(5)
  city             String?   @map("city") @db.VarChar(255)
  businessId       String?   @map("business_id") @db.VarChar(255)
  tenantId         String    @map("tenant_id") @db.Uuid
  tenant           Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at")
  orders           Order[]
  invoices         Invoice[]

  @@map("customer")
}

model CustomerHistory {
  revision  Int    @id @default(autoincrement()) @map("revision")
  operation String @map("operation")

  id               String   @map("id") @db.Uuid
  name             String   @map("name") @db.VarChar(50)
  companyLegalName String?  @map("company_legal_name") @db.VarChar(255)
  discount         Decimal  @map("discount") @db.Decimal(10, 2)
  invoiceReference String?  @map("invoice_reference") @db.VarChar(255)
  email            String?  @map("email") @db.VarChar(255)
  phone            String?  @map("phone") @db.VarChar(255)
  streetAddress    String?  @map("street_address") @db.VarChar(255)
  postalCode       String?  @map("postal_code") @db.VarChar(5)
  city             String?  @map("city") @db.VarChar(255)
  businessId       String?  @map("business_id") @db.VarChar(255)
  tenantId         String   @map("tenant_id") @db.Uuid
  createdAt        DateTime @map("created_at")
  updatedAt        DateTime @map("updated_at")

  @@map("customer_history")
}

model OrderRow {
  id          String   @id @default(uuid()) @map("id") @db.Uuid
  orderId     String   @map("order_id") @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  productId   String   @map("product_id") @db.Uuid
  amount      Decimal  @map("amount") @db.Decimal(10, 2)
  price       Decimal  @map("price") @db.Decimal(10, 2)
  packageSize Int      @map("package_size") @db.Integer
  freetext    String?  @map("freetext") @db.VarChar(500)
  packageType String?  @map("package_type") @db.VarChar(16)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("order_row")
}

model OrderRowHistory {
  revision  Int    @id @default(autoincrement()) @map("revision")
  operation String @map("operation")

  id          String   @map("id") @db.Uuid
  orderId     String   @map("order_id") @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  productId   String   @map("product_id") @db.Uuid
  amount      Decimal  @map("amount") @db.Decimal(10, 2)
  price       Decimal  @map("price") @db.Decimal(10, 2)
  packageSize Int      @map("package_size") @db.Integer
  freetext    String?  @map("freetext") @db.VarChar(500)
  packageType String?  @map("package_type") @db.VarChar(16)
  createdAt   DateTime @map("created_at")
  updatedAt   DateTime @map("updated_at")

  @@map("order_row_history")
}

model Product {
  id          String     @id @default(uuid()) @map("id") @db.Uuid
  tenantId    String     @map("tenant_id") @db.Uuid
  tenant      Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String     @map("name") @db.VarChar(64)
  price       Decimal?   @map("price") @db.Decimal(10, 2)
  packageSize Int?       @map("package_size") @db.Integer
  packageType String?    @map("package_type") @db.VarChar(16)
  active      Boolean?   @default(true) @map("active")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @default(now()) @updatedAt @map("updated_at")
  orderRows   OrderRow[]

  @@map("product")
}

model ProductHistory {
  revision  Int    @id @default(autoincrement()) @map("revision")
  operation String @map("operation")

  id          String   @map("id") @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  name        String   @map("name") @db.VarChar(64)
  price       Decimal? @map("price") @db.Decimal(10, 2)
  active      Boolean? @map("active")
  packageSize Int?     @map("package_size") @db.Integer
  packageType String?  @map("package_type") @db.VarChar(16)
  createdAt   DateTime @map("created_at")
  updatedAt   DateTime @map("updated_at")

  @@map("product_history")
}

enum InvoiceStatus {
  PENDING
  PAID
}

model Invoice {
  id            String        @id @default(uuid()) @map("id") @db.Uuid
  invoiceNumber Int           @map("invoice_number") @db.Integer
  customerId    String        @map("customer_id") @db.Uuid
  tenantId      String        @map("tenant_id") @db.Uuid
  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer      Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  filename      String        @map("filename") @db.VarChar(255)
  total         Decimal       @map("total") @db.Decimal(10, 2)
  status        InvoiceStatus @default(PENDING) @map("status")
  orders        Order[]
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @default(now()) @updatedAt @map("updated_at")

  @@map("invoice")
}

model InvoiceHistory {
  revision  Int    @id @default(autoincrement()) @map("revision")
  operation String @map("operation")

  id            String        @map("id") @db.Uuid
  invoiceNumber Int           @map("invoice_number") @db.Integer
  customerId    String        @map("customer_id") @db.Uuid
  tenantId      String        @map("tenant_id") @db.Uuid
  filename      String        @map("filename") @db.VarChar(255)
  total         Decimal       @map("total") @db.Decimal(10, 2)
  status        InvoiceStatus @map("status")
  createdAt     DateTime      @map("created_at")
  updatedAt     DateTime      @map("updated_at")

  @@map("invoice_history")
}

enum OrderStatus {
  WAITING_FOR_DELIVERY
  DELIVERED
  INVOICED
}

model Order {
  id           String      @id @default(uuid()) @map("id") @db.Uuid
  orderNumber  Int         @map("order_number") @db.Integer
  waybillS3Key String?     @map("waybill_s3_key") @db.VarChar(255)
  invoiceId    String?     @map("invoice_id") @db.Uuid
  invoice      Invoice?    @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  customerId   String      @map("customer_id") @db.Uuid
  deliveryDate DateTime    @map("delivery_date") @db.Date
  hasNote      Boolean     @map("has_note")
  noteBody     String?     @map("note_body") @db.VarChar(1000)
  noteHeader   String?     @map("note_header") @db.VarChar(255)
  customer     Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  orderRows    OrderRow[]
  tenantId     String      @map("tenant_id") @db.Uuid
  tenant       Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  status       OrderStatus @default(WAITING_FOR_DELIVERY) @map("status")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @default(now()) @updatedAt @map("updated_at")
  deletedAt    DateTime?   @map("deleted_at") @db.Date

  @@unique([orderNumber, tenantId], map: "order_number_uniq")
  @@index([customerId], map: "customer_id")
  @@map("order")
}

model OrderHistory {
  revision  Int    @id @default(autoincrement()) @map("revision")
  operation String @map("operation")

  id           String      @map("id") @db.Uuid
  orderNumber  Int         @map("order_number") @db.Integer
  waybillS3Key String?     @map("waybill_s3_key") @db.VarChar(255)
  invoiceId    String?     @map("invoice_id") @db.Uuid
  customerId   String      @map("customer_id") @db.Uuid
  deliveryDate DateTime    @map("delivery_date") @db.Date
  hasNote      Boolean     @map("has_note")
  noteBody     String?     @map("note_body") @db.VarChar(1000)
  noteHeader   String?     @map("note_header") @db.VarChar(255)
  tenantId     String      @map("tenant_id") @db.Uuid
  status       OrderStatus @default(WAITING_FOR_DELIVERY) @map("status")
  createdAt    DateTime    @map("created_at")
  updatedAt    DateTime    @map("updated_at")
  deletedAt    DateTime?   @map("deleted_at") @db.Date

  @@map("order_history")
}

model Log {
  id String @id @default(uuid()) @map("id") @db.Uuid

  // No FK since I want to retain logs after user is deleted
  userId String? @map("user_id") @db.Uuid

  // No FK since I want to retain logs after tenant is deleted
  tenantId String? @map("tenant_id") @db.Uuid

  event     String   @map("event") @db.VarChar(255)
  data      Json     @default("{}") @map("data")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("log")
}

model PackageType {
  id        String   @id @default(uuid()) @map("id") @db.Uuid
  name      String   @map("name") @db.VarChar(16)
  tenantId  String   @map("tenant_id") @db.Uuid
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("package_type")
}

model PackageTypeHistory {
  revision  Int    @id @default(autoincrement()) @map("revision")
  operation String @map("operation")

  id        String   @map("id") @db.Uuid
  name      String   @map("name") @db.VarChar(16)
  tenantId  String   @map("tenant_id") @db.Uuid
  createdAt DateTime @map("created_at")
  updatedAt DateTime @map("updated_at")

  @@map("package_type_history")
}

model PackageSize {
  id        String   @id @default(uuid()) @map("id") @db.Uuid
  size      Int      @map("size") @db.Integer
  tenantId  String   @map("tenant_id") @db.Uuid
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("package_size")
}

model PackageSizeHistory {
  revision  Int    @id @default(autoincrement()) @map("revision")
  operation String @map("operation")

  id        String   @map("id") @db.Uuid
  size      Int      @map("size") @db.Integer
  tenantId  String   @map("tenant_id") @db.Uuid
  createdAt DateTime @map("created_at")
  updatedAt DateTime @map("updated_at")

  @@map("package_size_history")
}
