// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgres"
  url      = env("DATABASE_URL")
}

model User {
  id    Int     @id @default(autoincrement())
  externalId String @db.VarChar(128) @unique
  username String @db.VarChar(128) @unique
  email String  @unique
  name  String?
  posts Post[]
}

model Post {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  title     String
  content   String?
  published Boolean  @default(false)
  viewCount Int      @default(0)
  author    User?    @relation(fields: [authorId], references: [id])
  authorId  Int?
}

model Order {
  order_id Int @id @default(autoincrement())
  customer_id Int
  delivery_date String
  has_note Boolean @default(false)
  note_header String @db.VarChar(256)
  note_body String @db.VarChar(256)
}

model Customer {
  customer_id Int @id @default(autoincrement())
  chain String @db.VarChar(3)
    name String @db.VarChar(50)
        address String @db.VarChar(255)
                compansation Float 
                reference String 
                companyName String
                orderIndex Int
                city String
                email String
                phone String
                postalCode String @db.VarChar(5)
                businessId String


}
