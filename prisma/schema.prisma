generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgres"
  url      = env("DATABASE_URL")
}

model Tenant {
  id String @id @default(uuid()) @db.Uuid
  name        String @db.VarChar(255) @map("name")
  streetAddress            String? @db.VarChar(255)  @map("street_address")
  postalCode            String? @db.VarChar(255) @map("postal_code")
  city            String? @db.VarChar(255)
  phone            String? @db.VarChar(255)
  email            String? @db.VarChar(255)
  website            String? @db.VarChar(255)
  businessId         String? @db.VarChar(255) @map("business_id")
  invoiceBankName   String? @db.VarChar(255) @map("invoice_bank_name")
  invoiceBankAccount String? @db.VarChar(255) @map("invoice_bank_account")
  invoiceSwiftBic String? @db.VarChar(255) @map("invoice_swift_bic")
  invoiceReference   String? @db.VarChar(255) @map("invoice_reference")
  invoiceSumRow     String? @db.VarChar(255) @map("invoice_sum_row")
  customers            Customer[]
  orders               Order[]
  users               User[]
  products             Product[]
  productTypes         ProductType[]
  productSubtypes      ProductSubtypes[]
  @@map("tenant")
}

model User {
  id String @id @default(uuid())
  googleExternalId String?  @unique @db.VarChar(128)
  email      String  @unique
  tenantId  String @db.Uuid
  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@map("user")
}

model EmailLoginPinCode {
  id        String   @id @default(cuid())
  email     String   @unique
  pinCode   String
  createdAt DateTime @default(now())
}


model Customer {
  id String @id @default(uuid()) @db.Uuid
  chain                  String   @db.VarChar(3)
  name                   String   @db.VarChar(50)
  address                String?  @db.VarChar(255)
  compensation           Float
  reference              String?  @db.VarChar(255)
  company_name           String?  @db.VarChar(255)
  order_index            Int?
  city                   String?  @db.VarChar(255)
  email                  String?  @db.VarChar(255)
  phone                  String?  @db.VarChar(255)
  postal_code            String?  @db.VarChar(5)
  address2               String?  @db.VarChar(255)
  business_id            String?  @db.VarChar(255)
  customer_group         String?  @db.VarChar(256)
  show_price_without_tax Boolean @default(false)
  orders                 Order[]
  tenantId               String @db.Uuid
  tenant                 Tenant @relation(fields: [tenantId], references: [id])

  @@map("customer")
}

model OrderProduct {
  id String @id @default(uuid()) @db.Uuid
  orderId          String @map("order_id") @db.Uuid
  productId        String @map("product_id") @db.Uuid
  amount           Int
  price            Float
  packageSize      Int @map("package_size")
  freetext         String? @db.VarChar(500)
  packageType      String? @db.VarChar(3) @map("package_type")
  price0           Float   @default(0)
  products         Product @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FKo6helt0ucmegaeachjpx40xhe")
  order            Order   @relation(fields: [orderId], references: [id])

  @@index([productId])
  @@map("order_product")
}

model ProductType {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  tenant Tenant @relation(fields: [tenantId], references: [id])
  order_index      Int
  type             String?           @db.VarChar(255)
  product_subtypes ProductSubtypes[]

  @@map("product_type")
}

model Product {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  tenant Tenant @relation(fields: [tenantId], references: [id])
  name           String         @db.VarChar(50)
  type           String         @db.VarChar(20)
  variety        String         @db.VarChar(20)
  info           String?        @db.VarChar(20)
  price          Float          
  order_index    Int?
  subtype        String?        @db.VarChar(255)
  package_size   String?        @db.VarChar(255)
  package_type   String?        @db.VarChar(255)
  price0         Float          @default(0)
  customer_group String?        @db.VarChar(256)
  active         Boolean?       @default(true)
  order_product  OrderProduct[]

  @@map("product")
}

model Order {
  id String @id @default(uuid()) @db.Uuid
  customerId          String          @map("customer_id") @db.Uuid
  deliveryDate        DateTime       @map("delivery_date") @db.Date
  hasNote             Boolean        @map("has_note")
  noteBody            String?        @map("note_body") @db.VarChar(1000)
  noteHeader          String?        @map("note_header") @db.VarChar(255)
  showPriceWithoutTax Boolean?       @default(false) @map("show_price_without_tax")
  customerGroup       String?        @map("customer_group") @db.VarChar(256)
  customer            Customer       @relation(fields: [customerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  products            OrderProduct[]
  tenantId            String @db.Uuid
  tenant              Tenant @relation(fields: [tenantId], references: [id])

  @@index([customerId], map: "customer_id")
  @@map("order")
}

model ProductSubtypes {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  tenant Tenant @relation(fields: [tenantId], references: [id])
  order_index   Int
  subtype       String?      @db.VarChar(255)
  type          String?      @db.VarChar(255)
  order_id      String?      @db.Uuid
  product_types ProductType? @relation(fields: [order_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([type, subtype], map: "product_subtypes_uniq")
  @@index([order_id])
  @@map("product_subtype")
}
