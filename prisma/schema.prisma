generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgres"
  url      = env("DATABASE_URL")
}

model Tenant {
  id                    String            @id @default(uuid()) @map("id") @db.Uuid
  name                  String            @map("name") @db.VarChar(255)
  streetAddress         String?           @map("street_address") @db.VarChar(255)
  postalCode            String?           @map("postal_code") @db.VarChar(255)
  city                  String?           @map("city") @db.VarChar(255)
  phone                 String?           @map("phone") @db.VarChar(255)
  email                 String?           @map("email") @db.VarChar(255)
  website               String?           @map("website") @db.VarChar(255)
  businessId            String?           @map("business_id") @db.VarChar(255)
  invoiceBankName       String?           @map("invoice_bank_name") @db.VarChar(255)
  invoiceBankAccount    String?           @map("invoice_bank_account") @db.VarChar(255)
  invoiceSwiftBic       String?           @map("invoice_swift_bic") @db.VarChar(255)
  invoiceReference      String?           @map("invoice_reference") @db.VarChar(255)
  invoiceSumRow         String?           @map("invoice_sum_row") @db.VarChar(255)
  signupCompleted       Boolean           @default(false) @map("signup_completed")
  createdAt             DateTime          @default(now()) @map("created_at")
  updatedAt             DateTime          @default(now()) @updatedAt @map("updated_at")
  subscriptionType      String            @default("FREE") @map("subscription_type")
  subscriptionEndDate   DateTime?         @map("subscription_end_date")
  subscriptionStartDate DateTime?         @map("subscription_start_date")
  trialEndDate          DateTime?         @map("trial_end_date")
  customers             Customer[]
  orders                Order[]
  orderProducts         OrderProduct[]
  users                 User[]
  products              Product[]
  productTypes          ProductType[]
  productSubtypes       ProductSubtypes[]
  PackageType           PackageType[]
  PackageSize           PackageSize[]

  @@map("tenant")
}

model TenantHistory {
  revision  Int    @id @default(autoincrement()) @map("revision")
  operation String @map("operation")

  id                    String    @map("id") @db.Uuid
  name                  String    @map("name") @db.VarChar(255)
  streetAddress         String?   @map("street_address") @db.VarChar(255)
  postalCode            String?   @map("postal_code") @db.VarChar(255)
  city                  String?   @map("city") @db.VarChar(255)
  phone                 String?   @map("phone") @db.VarChar(255)
  email                 String?   @map("email") @db.VarChar(255)
  website               String?   @map("website") @db.VarChar(255)
  businessId            String?   @map("business_id") @db.VarChar(255)
  invoiceBankName       String?   @map("invoice_bank_name") @db.VarChar(255)
  invoiceBankAccount    String?   @map("invoice_bank_account") @db.VarChar(255)
  invoiceSwiftBic       String?   @map("invoice_swift_bic") @db.VarChar(255)
  invoiceReference      String?   @map("invoice_reference") @db.VarChar(255)
  invoiceSumRow         String?   @map("invoice_sum_row") @db.VarChar(255)
  signupCompleted       Boolean   @map("signup_completed")
  createdAt             DateTime  @map("created_at")
  updatedAt             DateTime  @map("updated_at")
  subscriptionType      String    @map("subscription_type")
  subscriptionEndDate   DateTime? @map("subscription_end_date")
  subscriptionStartDate DateTime? @map("subscription_start_date")
  trialEndDate          DateTime? @map("trial_end_date")

  @@map("tenant_history")
}

model User {
  id               String    @id @default(uuid()) @map("id") @db.Uuid
  googleExternalId String?   @unique @map("google_external_id") @db.VarChar(128)
  email            String    @unique @map("email")
  tenantId         String    @map("tenant_id") @db.Uuid
  tenant           Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  marketingConsent Boolean   @default(false) @map("marketing_consent")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at")
  lastLoginAt      DateTime? @map("last_login_at")

  @@map("user")
}

model UserHistory {
  revision  Int    @id @default(autoincrement()) @map("revision")
  operation String @map("operation")

  id               String    @map("id") @db.Uuid
  googleExternalId String?   @map("google_external_id") @db.VarChar(128)
  email            String    @map("email")
  tenantId         String    @map("tenant_id") @db.Uuid
  marketingConsent Boolean   @map("marketing_consent")
  createdAt        DateTime  @map("created_at")
  updatedAt        DateTime  @map("updated_at")
  lastLoginAt      DateTime? @map("last_login_at")

  @@map("user_history")
}

model EmailLoginPinCode {
  id        String   @id @default(cuid()) @map("id")
  email     String   @map("email")
  pinCode   String   @map("pin_code")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("email_login_pin_code")
}

model EmailLoginPinCodeHistory {
  revision  Int    @id @default(autoincrement()) @map("revision")
  operation String @map("operation")

  id        String   @map("id")
  email     String   @map("email")
  pinCode   String   @map("pin_code")
  createdAt DateTime @map("created_at")
  updatedAt DateTime @map("updated_at")

  @@map("email_login_pin_code_history")
}

model Customer {
  id                  String   @id @default(uuid()) @map("id") @db.Uuid
  chain               String   @map("chain") @db.VarChar(32)
  name                String   @map("name") @db.VarChar(50)
  address             String?  @map("address") @db.VarChar(255)
  compensation        Float    @map("compensation")
  reference           String?  @map("reference") @db.VarChar(255)
  companyName         String?  @map("company_name") @db.VarChar(255)
  city                String?  @map("city") @db.VarChar(255)
  email               String?  @map("email") @db.VarChar(255)
  phone               String?  @map("phone") @db.VarChar(255)
  postalCode          String?  @map("postal_code") @db.VarChar(5)
  address2            String?  @map("address2") @db.VarChar(255)
  businessId          String?  @map("business_id") @db.VarChar(255)
  customerGroup       String?  @map("customer_group") @db.VarChar(256)
  showPriceWithoutTax Boolean  @default(false) @map("show_price_without_tax")
  orders              Order[]
  tenantId            String   @map("tenant_id") @db.Uuid
  tenant              Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("customer")
}

model CustomerHistory {
  revision  Int    @id @default(autoincrement()) @map("revision")
  operation String @map("operation")

  id                  String   @map("id") @db.Uuid
  chain               String   @map("chain") @db.VarChar(32)
  name                String   @map("name") @db.VarChar(50)
  address             String?  @map("address") @db.VarChar(255)
  compensation        Float    @map("compensation")
  reference           String?  @map("reference") @db.VarChar(255)
  companyName         String?  @map("company_name") @db.VarChar(255)
  city                String?  @map("city") @db.VarChar(255)
  email               String?  @map("email") @db.VarChar(255)
  phone               String?  @map("phone") @db.VarChar(255)
  postalCode          String?  @map("postal_code") @db.VarChar(5)
  address2            String?  @map("address2") @db.VarChar(255)
  businessId          String?  @map("business_id") @db.VarChar(255)
  customerGroup       String?  @map("customer_group") @db.VarChar(256)
  showPriceWithoutTax Boolean  @map("show_price_without_tax")
  tenantId            String   @map("tenant_id") @db.Uuid
  createdAt           DateTime @map("created_at")
  updatedAt           DateTime @map("updated_at")

  @@map("customer_history")
}

model OrderProduct {
  id          String   @id @default(uuid()) @map("id") @db.Uuid
  orderId     String   @map("order_id") @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  productId   String   @map("product_id") @db.Uuid
  amount      Int      @map("amount")
  price       Float    @map("price")
  packageSize Int      @map("package_size")
  freetext    String?  @map("freetext") @db.VarChar(500)
  packageType String?  @map("package_type") @db.VarChar(3)
  price0      Float    @default(0) @map("price0")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")
  products    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("order_product")
}

model OrderProductHistory {
  revision  Int    @id @default(autoincrement()) @map("revision")
  operation String @map("operation")

  id          String   @map("id") @db.Uuid
  orderId     String   @map("order_id") @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  productId   String   @map("product_id") @db.Uuid
  amount      Int      @map("amount")
  price       Float    @map("price")
  packageSize Int      @map("package_size")
  freetext    String?  @map("freetext") @db.VarChar(500)
  packageType String?  @map("package_type") @db.VarChar(3)
  price0      Float    @map("price0")
  createdAt   DateTime @map("created_at")
  updatedAt   DateTime @map("updated_at")

  @@map("order_product_history")
}

model ProductType {
  id              String            @id @default(uuid()) @map("id") @db.Uuid
  tenantId        String            @map("tenant_id") @db.Uuid
  tenant          Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orderIndex      Int               @map("order_index")
  type            String?           @map("type") @db.VarChar(255)
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @default(now()) @updatedAt @map("updated_at")
  productSubtypes ProductSubtypes[]

  @@map("product_type")
}

model ProductTypeHistory {
  revision  Int    @id @default(autoincrement()) @map("revision")
  operation String @map("operation")

  id         String   @map("id") @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  orderIndex Int      @map("order_index")
  type       String?  @map("type") @db.VarChar(255)
  createdAt  DateTime @map("created_at")
  updatedAt  DateTime @map("updated_at")

  @@map("product_type_history")
}

model Product {
  id            String         @id @default(uuid()) @map("id") @db.Uuid
  tenantId      String         @map("tenant_id") @db.Uuid
  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name          String         @map("name") @db.VarChar(64)
  variety       String?        @map("variety") @db.VarChar(32)
  info          String?        @map("info") @db.VarChar(32)
  price         Float?         @map("price")
  type          String?        @map("type") @db.VarChar(32)
  subtype       String?        @map("subtype") @db.VarChar(255)
  packageSize   String?        @map("package_size") @db.VarChar(255)
  packageType   String?        @map("package_type") @db.VarChar(255)
  price0        Float?         @default(0) @map("price0")
  customerGroup String?        @map("customer_group") @db.VarChar(256)
  active        Boolean?       @default(true) @map("active")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @default(now()) @updatedAt @map("updated_at")
  orderProduct  OrderProduct[]

  @@map("product")
}

model ProductHistory {
  revision  Int    @id @default(autoincrement()) @map("revision")
  operation String @map("operation")

  id            String   @map("id") @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  name          String   @map("name") @db.VarChar(64)
  variety       String?  @map("variety") @db.VarChar(32)
  info          String?  @map("info") @db.VarChar(32)
  price         Float?   @map("price")
  type          String?  @map("type") @db.VarChar(32)
  subtype       String?  @map("subtype") @db.VarChar(255)
  packageSize   String?  @map("package_size") @db.VarChar(255)
  packageType   String?  @map("package_type") @db.VarChar(255)
  price0        Float?   @map("price0")
  customerGroup String?  @map("customer_group") @db.VarChar(256)
  active        Boolean? @map("active")
  createdAt     DateTime @map("created_at")
  updatedAt     DateTime @map("updated_at")

  @@map("product_history")
}

model Order {
  id                  String         @id @default(uuid()) @map("id") @db.Uuid
  customerId          String         @map("customer_id") @db.Uuid
  deliveryDate        DateTime       @map("delivery_date") @db.Date
  hasNote             Boolean        @map("has_note")
  noteBody            String?        @map("note_body") @db.VarChar(1000)
  noteHeader          String?        @map("note_header") @db.VarChar(255)
  showPriceWithoutTax Boolean?       @default(false) @map("show_price_without_tax")
  customerGroup       String?        @map("customer_group") @db.VarChar(256)
  customer            Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  products            OrderProduct[]
  tenantId            String         @map("tenant_id") @db.Uuid
  tenant              Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt           DateTime       @default(now()) @map("created_at")
  updatedAt           DateTime       @default(now()) @updatedAt @map("updated_at")

  @@index([customerId], map: "customer_id")
  @@map("order")
}

model OrderHistory {
  revision  Int    @id @default(autoincrement()) @map("revision")
  operation String @map("operation")

  id                  String   @map("id") @db.Uuid
  customerId          String   @map("customer_id") @db.Uuid
  deliveryDate        DateTime @map("delivery_date") @db.Date
  hasNote             Boolean  @map("has_note")
  noteBody            String?  @map("note_body") @db.VarChar(1000)
  noteHeader          String?  @map("note_header") @db.VarChar(255)
  showPriceWithoutTax Boolean? @map("show_price_without_tax")
  customerGroup       String?  @map("customer_group") @db.VarChar(256)
  tenantId            String   @map("tenant_id") @db.Uuid
  createdAt           DateTime @map("created_at")
  updatedAt           DateTime @map("updated_at")

  @@map("order_history")
}

model ProductSubtypes {
  id           String       @id @default(uuid()) @map("id") @db.Uuid
  tenantId     String       @map("tenant_id") @db.Uuid
  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orderIndex   Int          @map("order_index")
  subtype      String?      @map("subtype") @db.VarChar(255)
  type         String?      @map("type") @db.VarChar(255)
  orderId      String?      @map("order_id") @db.Uuid
  productTypes ProductType? @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @default(now()) @updatedAt @map("updated_at")

  @@unique([type, subtype], map: "product_subtype_uniq")
  @@index([orderId])
  @@map("product_subtype")
}

model ProductSubtypeHistory {
  revision  Int    @id @default(autoincrement()) @map("revision")
  operation String @map("operation")

  id         String   @map("id") @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  orderIndex Int      @map("order_index")
  subtype    String?  @map("subtype") @db.VarChar(255)
  type       String?  @map("type") @db.VarChar(255)
  orderId    String?  @map("order_id") @db.Uuid
  createdAt  DateTime @map("created_at")
  updatedAt  DateTime @map("updated_at")

  @@map("product_subtype_history")
}

model RateLimit {
  id        String   @id @default(uuid()) @map("id") @db.Uuid
  ip        String   @map("ip") @db.VarChar(255)
  key       String   @map("key") @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("rate_limit")
}

model RateLimitHistory {
  revision  Int    @id @default(autoincrement()) @map("revision")
  operation String @map("operation")

  id        String   @map("id") @db.Uuid
  ip        String   @map("ip") @db.VarChar(255)
  key       String   @map("key") @db.VarChar(255)
  createdAt DateTime @map("created_at")
  updatedAt DateTime @map("updated_at")

  @@map("rate_limit_history")
}

model Log {
  id String @id @default(uuid()) @map("id") @db.Uuid

  // No FK since I want to retain logs after user is deleted
  userId String? @map("user_id") @db.Uuid

  // No FK since I want to retain logs after tenant is deleted
  tenantId String? @map("tenant_id") @db.Uuid

  event     String   @map("event") @db.VarChar(255)
  data      Json     @default("{}") @map("data")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("log")
}

model PackageType {
  id        String   @id @default(uuid()) @map("id") @db.Uuid
  name      String   @map("name") @db.VarChar(255)
  tenantId  String   @map("tenant_id") @db.Uuid
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("package_type")
}

model PackageTypeHistory {
  revision  Int    @id @default(autoincrement()) @map("revision")
  operation String @map("operation")

  id        String   @map("id") @db.Uuid
  name      String   @map("name") @db.VarChar(255)
  tenantId  String   @map("tenant_id") @db.Uuid
  createdAt DateTime @map("created_at")
  updatedAt DateTime @map("updated_at")

  @@map("package_type_history")
}

model PackageSize {
  id        String   @id @default(uuid()) @map("id") @db.Uuid
  size      Int      @map("size")
  tenantId  String   @map("tenant_id") @db.Uuid
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("package_size")
}

model PackageSizeHistory {
  revision  Int    @id @default(autoincrement()) @map("revision")
  operation String @map("operation")

  id        String   @map("id") @db.Uuid
  size      Int      @map("size")
  tenantId  String   @map("tenant_id") @db.Uuid
  createdAt DateTime @map("created_at")
  updatedAt DateTime @map("updated_at")

  @@map("package_size_history")
}
