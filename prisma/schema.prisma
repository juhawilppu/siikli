generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id    Int     @id @default(autoincrement())
  externalId String @db.VarChar(128) @unique
  username String @db.VarChar(128) @unique
  email String  @unique
  name  String?
}

model Company {
  id                  Int     @id @default(autoincrement())
  address1            String? @db.VarChar(255)
  address2            String? @db.VarChar(255)
  business_id         String? @db.VarChar(255)
  company_name        String? @db.VarChar(255)
  invoice_bank_name   String? @db.VarChar(255)
  invoice_bank_number String? @db.VarChar(255)
  invoice_reference   String? @db.VarChar(255)
  invoice_sum_row     String? @db.VarChar(255)

  @@map("company")
}

model Customer {
  customer_id            Int      @id @default(autoincrement())
  chain                  String   @db.VarChar(3)
  name                   String   @db.VarChar(50)
  address                String?  @db.VarChar(255)
  compensation           Float
  reference              String?  @db.VarChar(255)
  company_name           String?  @db.VarChar(255)
  order_index            Int?
  city                   String?  @db.VarChar(255)
  email                  String?  @db.VarChar(255)
  phone                  String?  @db.VarChar(255)
  postal_code            String?  @db.VarChar(5)
  address2               String?  @db.VarChar(255)
  business_id            String?  @db.VarChar(255)
  customer_group         String?  @db.VarChar(256)
  show_price_without_tax Boolean? @default(false)
  orders                 Order[]

  @@map("customers")
}

model OrderProduct {
  order_product_id Int     @id @default(autoincrement())
  order_id         Int
  product_id       Int
  amount           Int
  price            Float   @db.Float
  package_size     Int
  freetext         String? @db.VarChar(500)
  package_type     String? @db.VarChar(3)
  price0           Float   @default(0) @db.Float
  products         Product @relation(fields: [product_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FKo6helt0ucmegaeachjpx40xhe")

  @@index([product_id], map: "FKo6helt0ucmegaeachjpx40xhe")
  @@map("order_product")
}

model ProductType {
  id               Int               @id @default(autoincrement()) @map("product_order_index")
  order_index      Int
  type             String?           @unique(map: "product_types_uniq") @db.VarChar(255)
  product_subtypes ProductSubtypes[]

  @@map("product_types")
}

model Product {
  id             Int            @id @default(autoincrement()) @map("product_id")
  name           String         @db.VarChar(50)
  type           String         @db.VarChar(20)
  variety        String         @db.VarChar(20)
  info           String?        @db.VarChar(20)
  price          Float          @db.Float
  order_index    Int?
  subtype        String?        @db.VarChar(255)
  package_size   String?        @db.VarChar(255)
  package_type   String?        @db.VarChar(255)
  price0         Float          @default(0) @db.Float
  customer_group String?        @db.VarChar(256)
  active         Boolean?       @default(true)
  order_product  OrderProduct[]

  @@map("products")
}

model Order {
  id                     Int      @id @unique(map: "order_id") @default(autoincrement()) @map("order_id")
  customer_id            Int
  delivery_date          DateTime @db.Date
  has_note               Boolean  @db.Bit(1)
  note_body              String?  @db.VarChar(1000)
  note_header            String?  @db.VarChar(255)
  show_price_without_tax Boolean? @default(false)
  customer_group         String?  @db.VarChar(256)
  customers              Customer @relation(fields: [customer_id], references: [customer_id], onDelete: NoAction, onUpdate: NoAction, map: "FKpxtb8awmi0dk6smoh2vp1litg")

  @@index([customer_id], map: "customer_id")
  @@map("orders")
}

model ProductSubtypes {
  subtype_index Int          @id @default(autoincrement())
  order_index   Int
  subtype       String?      @db.VarChar(255)
  type          String?      @db.VarChar(255)
  order_id      Int?
  product_types ProductType? @relation(fields: [order_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FKgyv4ku1m3s5hid3clootvtqcv")

  @@unique([type, subtype], map: "product_subtypes_uniq")
  @@index([order_id], map: "FKgyv4ku1m3s5hid3clootvtqcv")
  @@map("product_subtypes")
}
